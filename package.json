{
  "name": "chess-books-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop browser for annotated chess-book SQLite archives",
  "type": "module",
  "main": "electron/main.mjs",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "test": "node --test tests/*.test.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@lichess-org/pgn-viewer": "^2.6.4",
    "better-sqlite3": "^12.4.1",
    "fzstd": "^0.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "sass": "^1.93.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "org.chessbooks.explorer",
    "productName": "Chess Books Explorer",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asar": true,
    "asarUnpack": ["node_modules/better-sqlite3/**"],
    "directories": {"output": "release"},
    "mac": {"target": ["dmg", "zip"], "category": "public.app-category.education"},
    "win": {"target": ["nsis"]},
    "linux": {"target": ["AppImage", "deb"], "category": "Education"}
  }
}
