{
  "name": "chess-books-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "Local desktop browser for annotated chess games",
  "type": "module",
  "main": "electron/main.mjs",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && node scripts/start-electron.mjs . --dev\"",
    "start": "node scripts/start-electron.mjs .",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "test": "node --test tests/*.test.mjs && npm run test:archive",
    "test:archive": "node scripts/run-archive-tool.mjs --test tests/*.check.mjs",
    "migrate:games": "node scripts/run-archive-tool.mjs scripts/migrate-games.mjs",
    "study-markers": "node scripts/run-archive-tool.mjs scripts/critical-positions.mjs",
    "critical-positions": "node scripts/run-archive-tool.mjs scripts/critical-positions.mjs",
    "openings": "node scripts/run-archive-tool.mjs scripts/openings.mjs",
    "position-index": "node scripts/run-archive-tool.mjs scripts/position-index.mjs",
    "positions": "node scripts/run-archive-tool.mjs scripts/positions.mjs",
    "benchmark:positions": "node scripts/run-archive-tool.mjs scripts/benchmark-positions.mjs",
    "benchmark:position-variations": "node scripts/run-archive-tool.mjs scripts/benchmark-position-variations.mjs",
    "test:desktop": "npm run build && node scripts/start-electron.mjs tests/desktop-smoke.mjs && node scripts/start-electron.mjs tests/openings-desktop-smoke.mjs && node scripts/start-electron.mjs tests/engine-desktop-smoke.mjs && node scripts/start-electron.mjs tests/critical-positions-desktop-smoke.mjs && node scripts/start-electron.mjs tests/favourites-desktop-smoke.mjs && node scripts/start-electron.mjs tests/personal-desktop-smoke.mjs && node scripts/start-electron.mjs tests/personal-edit-desktop-smoke.mjs && node scripts/start-electron.mjs tests/position-search-desktop-smoke.mjs && node scripts/start-electron.mjs tests/position-review-search-desktop-smoke.mjs",
    "postinstall": "electron-builder install-app-deps",
    "engines:verify": "node scripts/verify-local-engines.mjs",
    "test:engines:local": "npm run build && node scripts/start-electron.mjs tests/real-engine-desktop.mjs"
  },
  "dependencies": {
    "@lichess-org/pgn-viewer": "^2.6.4",
    "better-sqlite3": "^12.4.1",
    "chessops": "^0.15.1",
    "fzstd": "^0.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "sass": "^1.93.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "org.chessbooks.explorer",
    "productName": "Annotated Games Explorer",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "lib/**/*.mjs",
      "lib/polyglot-keys.LICENSE",
      "db/migrations/008_personal_analysis.sql",
      "db/migrations/009_position_index.sql",
      "src/*.mjs",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "electron/maia_bridge.py"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "electron-winstaller@5.4.0": true
  }
}
